# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Used by Prisma for both runtime and migrations.
DATABASE_URL="postgresql://ohm7:ohm7@localhost:5432/ohm7?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ character random string used to sign session JWTs. Rotate per env.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in scan/claim links).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Messaging provider (WhatsApp / SMS)
# ---------------------------------------------------------------------------
# REQUIRED in production. One of:
#   simulated     — dev/test only; prints codes to the server console.
#                   Refused in production unless explicitly allowed below.
#   twilio        — Twilio REST API (TODO wired; throws until implemented).
#   sequencenow   — Internal SequenceNow webhook (TODO wired; throws until
#                   implemented).
#   disabled      — Refuses to send. Use when messaging is temporarily down.
OHM7_MESSAGE_PROVIDER="simulated"

# Production escape hatch ONLY — leave unset in real prod.
# OHM7_ALLOW_SIMULATED_PROVIDER_IN_PRODUCTION="true"

# Twilio (only required when OHM7_MESSAGE_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # e.g. whatsapp:+14155238886
TWILIO_SMS_FROM=""             # e.g. +15555550100

# SequenceNow (only required when OHM7_MESSAGE_PROVIDER=sequencenow)
SEQUENCENOW_WEBHOOK_URL=""
SEQUENCENOW_API_KEY=""

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# REQUIRED in production. One of:
#   memory    — process-local; single-instance only. Refused in production
#               unless OHM7_ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION=true.
#   redis     — uses REDIS_URL (TODO wired; throws until implemented).
#   disabled  — allow everything. Tests only.
OHM7_RATE_LIMIT_PROVIDER="memory"

# Production escape hatch for memory limiter on a single-instance deploy.
# OHM7_ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION="true"

REDIS_URL=""
