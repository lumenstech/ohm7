# PostgreSQL connection string used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:5432/ohm7?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ohm7?schema=public"

# 32+ byte random string used to sign session JWTs.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app (used in scan/claim links).
APP_URL="http://localhost:3000"

# Optional WhatsApp / SMS provider configuration.
# When unset the app uses a development "simulated" provider that prints the
# verification code to the server log. DO NOT ship production without a real
# provider.
WHATSAPP_PROVIDER=""           # "twilio" | "" (simulated)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # whatsapp:+14155238886
SMS_FROM=""                    # +15555550100
