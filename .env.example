# ─── Identity (Auth0) ──────────────────────────────────────────────────
AUTH0_SECRET=use_openssl_rand_hex_32
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
APP_BASE_URL=http://localhost:3000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dht:dht@localhost:5432/dht_dev

# ─── Messaging (BSP) ───────────────────────────────────────────────────
# One of: dialog360 | gupshup | simulated | disabled
DHT_MESSAGE_PROVIDER=simulated
DHT_ALLOW_SIMULATED_PROVIDER_IN_PRODUCTION=false

# Dialog360 (primary BSP)
DHT_DIALOG360_API_KEY=
DHT_DIALOG360_BASE_URL=https://waba-v2.360dialog.io

# Gupshup (secondary BSP)
DHT_GUPSHUP_API_KEY=
DHT_GUPSHUP_APP_NAME=
DHT_GUPSHUP_SOURCE_NUMBER=

# ─── Approval orchestrator ─────────────────────────────────────────────
# One of: sequencenow | disabled
DHT_APPROVAL_ORCHESTRATOR=disabled
DHT_SEQUENCENOW_WEBHOOK_SECRET=

# ─── Rate limiting ─────────────────────────────────────────────────────
# One of: memory | redis | disabled
DHT_RATE_LIMIT_PROVIDER=memory
DHT_ALLOW_MEMORY_RATE_LIMIT_IN_PRODUCTION=false
REDIS_URL=

# ─── Misc ──────────────────────────────────────────────────────────────
NODE_ENV=development
