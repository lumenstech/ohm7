// ServiceFixes Digital Home Twin (DHT) — property digital twin (MVP)
//
// Multi-tenant via tenant_id where useful; for the MVP a single implicit
// tenant is fine — the column is kept so we don't have to migrate it in.
//
// Enums kept narrow on purpose; the v0.2 spec is explicit about valid
// values for protection_type, created_via, claim verification_status, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users / auth
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  trade
  tenant
  admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  auth0Sub     String   @unique
  fullName     String?
  phone        String?
  company      String?
  role         UserRole @default(owner)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProperties   Property[]         @relation("PropertyOwner")
  grantsRequested   AccessGrant[]      @relation("GrantRequester")
  grantsApproved    AccessGrant[]      @relation("GrantApprover")
  serviceEvents     ServiceEvent[]     @relation("ServiceEventActor")
  tenantRequests    TenantServiceRequest[] @relation("TenantRequester")
  auditEvents       AuditEvent[]       @relation("AuditActor")
  invitesCreated    TenantInvite[]     @relation("TenantInviteCreator")
  invitesAccepted   TenantInvite[]     @relation("TenantInviteAcceptor")
  unitAccess        UnitTenantAccess[]
  approvalsAsApprover ApprovalRequest[] @relation("ApprovalApprover")

  @@index([auth0Sub])
}

// ---------------------------------------------------------------------------
// Jurisdictions (NEC edition lookup)
// ---------------------------------------------------------------------------

enum JurisdictionLevel {
  state
  county
  municipal
}

model Jurisdiction {
  id              String             @id @default(cuid())
  name            String
  state           String?            // 2-letter; null for non-state levels that already capture it through parent
  level           JurisdictionLevel
  parentId        String?
  parent          Jurisdiction?      @relation("JurisdictionParent", fields: [parentId], references: [id])
  children        Jurisdiction[]     @relation("JurisdictionParent")
  necEdition      String?            // "2017" | "2020" | "2023"
  necEditionYear  Int?               // numeric form for filtering
  necAdoptedDate  DateTime?
  ahjUrl          String?            // optional link to the local AHJ
  notes           String?
  amendments      Json               @default("{}")
  properties      Property[]
  createdAt       DateTime           @default(now())
}

// ---------------------------------------------------------------------------
// Property / Unit
// ---------------------------------------------------------------------------

enum PropertyType {
  single_family
  multi_family
  commercial
  mixed_use
}

model Property {
  id             String       @id @default(cuid())
  tenantId       String       @default("default")
  addressLine1   String
  addressLine2   String?
  city           String?
  state          String?      // 2-letter
  zip            String?
  country        String       @default("US")
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  propertyType   PropertyType @default(single_family)
  unitCount      Int          @default(1)
  yearBuilt      Int?
  parcelId       String?
  ownerUserId    String?
  owner          User?        @relation("PropertyOwner", fields: [ownerUserId], references: [id])
  nickname       String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units          Unit[]
  panels         Panel[]
  shortCodes     PanelShortCode[]
  grants         AccessGrant[]
  serviceEvents  ServiceEvent[]
  tenantRequests TenantServiceRequest[]
  invites        TenantInvite[]
  tenantAccess   UnitTenantAccess[]

  @@index([ownerUserId])
  @@index([jurisdictionId])
}

model Unit {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId     String   @default("default")
  unitNumber   String?
  floor        Int?
  bedrooms     Int?
  bathrooms    Float?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  panels       Panel[]
  serviceEvents ServiceEvent[]
  tenantRequests TenantServiceRequest[]
  grants       AccessGrant[]
  tenantAccess UnitTenantAccess[]
  invites      TenantInvite[]

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Panel / Circuit / Breaker
// ---------------------------------------------------------------------------

enum StickerPlacement {
  outside_cover
  deadfront
  inside_panel
  unknown
}

enum Phase {
  single_phase
  three_phase
  split_phase
  unknown
}

model Panel {
  id                String           @id @default(cuid())
  propertyId        String
  property          Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id])
  tenantId          String           @default("default")
  nickname          String?
  locationDescription String?
  manufacturer      String?
  panelLine         String?          // QO | Homeline | BR | CH | Q-Line | Stab-Lok …
  modelNumber       String?
  serialNumber      String?
  busRatingAmps     Int?
  mainBreakerAmps   Int?             // null = main-lug only
  voltage           String?          // "120/240" | "120/208" | "277/480"
  phase             Phase            @default(single_phase)
  numSpaces         Int?
  maxCircuits       Int?
  serviceEntrance   Boolean          @default(false)
  isMain            Boolean          @default(true)
  fedFromPanelId    String?
  fedFromPanel      Panel?           @relation("PanelFeed", fields: [fedFromPanelId], references: [id])
  subPanels         Panel[]          @relation("PanelFeed")
  installationYear  Int?
  conditionNotes    String?
  stickerPlacement  StickerPlacement @default(unknown)
  recallFlag        Boolean          @default(false)
  recallReason      String?
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  circuits          Circuit[]
  shortCodes        PanelShortCode[]
  serviceEvents     ServiceEvent[]
  grants            AccessGrant[]

  @@index([propertyId])
}

enum ProtectionType {
  standard
  afci
  gfci
  dfci
  cafci
  dual_function
}

model Circuit {
  id                  String         @id @default(cuid())
  panelId             String
  panel               Panel          @relation(fields: [panelId], references: [id], onDelete: Cascade)
  tenantId            String         @default("default")
  circuitNumber       Int            // primary slot
  positionB           Int?           // second slot for 2-pole/tandem
  label               String?
  areaServed          String?
  loadType            String?
  breakerAmperage     Int?
  breakerPoleCount    Int?           // 1 | 2 | 3
  breakerManufacturer String?
  breakerModel        String?
  protectionType      ProtectionType @default(standard)
  isTandem            Boolean        @default(false)
  wireSizeAwg         String?
  wireMethod          String?
  notes               String?
  metadata            Json           @default("{}")
  addedByUserId       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  serviceEvents       ServiceEvent[]

  @@unique([panelId, circuitNumber])
  @@index([panelId])
}

// ---------------------------------------------------------------------------
// QR / sticker short codes
// ---------------------------------------------------------------------------

enum ShortCodeStatus {
  unassigned
  active
  replaced
  retired
}

model PanelShortCode {
  id              String          @id @default(cuid())
  shortCode       String          @unique
  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id])
  panelId         String?
  panel           Panel?          @relation(fields: [panelId], references: [id])
  locationLabel   String?
  stickerBatchId  String?
  status          ShortCodeStatus @default(unassigned)
  activatedAt     DateTime?
  activatedByUserId String?
  lastScannedAt   DateTime?
  scanCount       Int             @default(0)
  createdAt       DateTime        @default(now())

  scans           ScanEvent[]

  @@index([propertyId])
  @@index([panelId])
}

enum ScanOutcome {
  viewed_public
  auth_prompted
  access_requested
  granted
  denied
  timeout
}

model ScanEvent {
  id            String           @id @default(cuid())
  shortCodeId   String
  shortCode     PanelShortCode   @relation(fields: [shortCodeId], references: [id])
  scannedByUserId String?
  scannedAt     DateTime         @default(now())
  ipAddress     String?
  userAgent     String?
  deviceFp      String?
  outcome       ScanOutcome      @default(viewed_public)

  @@index([shortCodeId])
}

// PropertyClaim + ClaimStatus + VerificationChannel removed in v0.3.1.
// Replaced by PendingClaim + Auth0. The intermediate 6-digit verification
// flow is gone; identity proof now comes from Auth0 sign-up keyed to the
// same email the claimant supplied.

// ---------------------------------------------------------------------------
// Access grants
// ---------------------------------------------------------------------------

enum GrantStatus {
  pending
  approved
  denied
  revoked
  expired
}

enum GrantCreatedVia {
  scan
  portal
  api
}

enum GrantScope {
  property
  panel
  unit
}

model AccessGrant {
  id                String          @id @default(cuid())
  propertyId        String
  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  panelId           String?
  panel             Panel?          @relation(fields: [panelId], references: [id])
  unitId            String?
  unit              Unit?           @relation(fields: [unitId], references: [id])
  tradeUserId       String?
  tradeUser         User?           @relation("GrantRequester", fields: [tradeUserId], references: [id])
  requesterName     String
  requesterCompany  String?
  requesterPhone    String?
  requesterEmail    String?
  requesterLicense  String?
  reason            String?
  scope             GrantScope      @default(property)
  status            GrantStatus     @default(pending)
  createdVia        GrantCreatedVia @default(scan)
  approvedByUserId  String?
  approvedBy        User?           @relation("GrantApprover", fields: [approvedByUserId], references: [id])
  approvedAt        DateTime?
  deniedAt          DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime?
  reasonDenied      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([propertyId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Service events
// ---------------------------------------------------------------------------

enum ServiceEventSource {
  manual
  scan
  invoicechats
  api
}

enum Trade {
  electrical
  plumbing
  hvac
  general
  roofing
  other
}

model ServiceEvent {
  id                    String              @id @default(cuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  panelId               String?
  panel                 Panel?              @relation(fields: [panelId], references: [id])
  circuitId             String?
  circuit               Circuit?            @relation(fields: [circuitId], references: [id])
  unitId                String?
  unit                  Unit?               @relation(fields: [unitId], references: [id])
  performedByUserId     String?
  performedBy           User?               @relation("ServiceEventActor", fields: [performedByUserId], references: [id])
  trade                 Trade               @default(electrical)
  eventType             String              // install | repair | replace | inspect | troubleshoot | upgrade
  summary               String
  notes                 String?
  necSectionReferenced  Json                @default("[]") // ["210.8(A)", "408.4(A)"]
  partsUsed             Json                @default("[]")
  photos                Json                @default("[]")
  permitNumber          String?
  invoiceReference      String?
  source                ServiceEventSource  @default(manual)
  performedAt           DateTime?
  durationMinutes       Int?
  costCents             BigInt?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([propertyId])
  @@index([panelId])
  @@index([circuitId])
}

// ---------------------------------------------------------------------------
// Tenant service requests
// ---------------------------------------------------------------------------

enum TenantRequestStatus {
  open
  acknowledged
  in_progress
  resolved
  closed
}

model TenantServiceRequest {
  id            String              @id @default(cuid())
  propertyId    String
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?               @relation(fields: [unitId], references: [id])
  tenantUserId  String
  tenant        User                @relation("TenantRequester", fields: [tenantUserId], references: [id])
  category      String              // electrical | plumbing | hvac | other
  summary       String
  details       String?
  status        TenantRequestStatus @default(open)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([propertyId])
  @@index([tenantUserId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  actorRole    UserRole?
  action       String
  entityType   String
  entityId     String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Tenant invites + accepted unit access
// ---------------------------------------------------------------------------

enum TenantInviteStatus {
  pending
  accepted
  revoked
  expired
}

model TenantInvite {
  id             String              @id @default(cuid())
  propertyId     String
  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?               @relation(fields: [unitId], references: [id])
  createdByUserId String
  createdBy      User                @relation("TenantInviteCreator", fields: [createdByUserId], references: [id])
  token          String              @unique
  inviteEmail    String?             // optional pre-fill / verification target
  inviteName     String?
  status         TenantInviteStatus  @default(pending)
  acceptedByUserId String?
  acceptedBy     User?               @relation("TenantInviteAcceptor", fields: [acceptedByUserId], references: [id])
  acceptedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([propertyId])
  @@index([status])
}

model UnitTenantAccess {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id])
  tenantUserId String
  tenantUser   User     @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  inviteId     String?
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([propertyId, tenantUserId])
  @@index([tenantUserId])
}

// ---------------------------------------------------------------------------
// Anonymous claim → Auth0 signup handoff
// ---------------------------------------------------------------------------

model PendingClaim {
  id         String    @id @default(cuid())
  token      String    @unique
  shortCode  String
  email      String
  proofData  Json
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([email])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Approval orchestration (SequenceNow / others)
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  pending
  approved
  denied
  approved_once
  expired
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  correlationId     String         @unique
  providerMessageId String         @unique
  approverPhone     String
  approverUserId    String?
  approver          User?          @relation("ApprovalApprover", fields: [approverUserId], references: [id])
  status            ApprovalStatus @default(pending)
  expiresAt         DateTime
  resolvedAt        DateTime?
  context           Json           @default("{}")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([approverPhone])
  @@index([status])
}
